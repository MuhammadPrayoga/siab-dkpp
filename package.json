{
  "name": "siab-dkpp",
  "version": "1.0.0",
  "description": "Sistem Informasi Agregator Berita DKPP - Crawling  Tool untuk Dewan Kehormatan Penyelenggara Pemilu",
  "main": "main.js",
  "scripts": {
    "start": "electron . --no-sandbox --disable-dev-shm-usage",
    "dev": "electron . --enable-logging",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/output.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/output.css --watch"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "flatpickr": "^4.6.13",
    "google-news-decoder": "^1.0.1",
    "jsdom": "^24.1.0",
    "lowdb": "^1.0.0",
    "puppeteer-core": "^22.15.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "electron": "^30.1.0",
    "tailwindcss": "^3.4.0"
  },
  "author": "SIAB DKPP",
  "license": "MIT"
}
